# ===================================================
# CareerFit Environment Variables Example
# Copy this file to server/.env or root .env as needed
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/careerfit

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Optional AI Service (For Phase 3)
# GEMINI_API_KEY=your_gemini_api_key_here
