# ===================================================
# CareerFit Environment Variables Example
# Copy this file to server/.env or root .env as needed
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/careerfit

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend
CLIENT_URL=http://localhost:5173

# Initial Dedicated Administrator Credentials (DO NOT put real credentials here; configure only in private local .env)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Gemini Flash AI Enrichment (strictly ₹0 free tier, non-blocking fallback if absent)
# Free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
