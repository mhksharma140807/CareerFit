# ===================================================
# CareerFit Environment Variables Example
# Copy this file to server/.env or root .env as needed
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/careerfit

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend
CLIENT_URL=http://localhost:5173

# Initial Dedicated Administrator Credentials (used by 'npm run seed:admin')
ADMIN_EMAIL=admin@careerfit.local
ADMIN_PASSWORD=your_strong_admin_password_min_8_chars

# Optional AI Service (For Phase 3)
#GEMINI_API_KEY=your_gemini_api_key_here
