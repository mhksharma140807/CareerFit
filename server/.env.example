PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/careerfit
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Initial Dedicated Administrator Credentials (DO NOT put real credentials here; configure only in private local .env)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Gemini Flash AI Enrichment (strictly ₹0 free tier, graceful fallback to deterministic engine if empty)
# Free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
